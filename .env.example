# Copy to .env (git-ignored) and adjust. Read by the API and Prisma.

NODE_ENV=development

# API
API_PORT=3000
LOG_LEVEL=info

# Postgres + PostGIS and Redis from infrastructure/docker-compose.yml (`pnpm db:up`)
DATABASE_URL=postgresql://turf:turf@localhost:5432/turf
REDIS_URL=redis://localhost:6379
